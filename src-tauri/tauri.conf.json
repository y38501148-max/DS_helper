{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DS_helper",
  "version": "1.3.0",
  "identifier": "cn.dshelper.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "beforeBuildCommand": "npm run build:web",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "DS_helper v1.3.0",
        "width": 1180,
        "height": 780,
        "minWidth": 980,
        "minHeight": 640,
        "backgroundColor": "#edf2ef"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/ds_helper_data.json": "ds_helper_data.json"
    }
  }
}
