{
  "name": "ds-helper",
  "version": "1.0.0",
  "description": "DS_helper offline data-structure template and fill-tool desktop app",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:tauri": "python3 tools/export_tauri_data.py && python3 tools/create_tauri_icons.py",
    "dev:web": "vite --host 127.0.0.1",
    "build:web": "npm run prepare:tauri && vite build",
    "tauri": "tauri",
    "dev": "tauri dev",
    "build": "tauri build",
    "pack:win": "tauri build --bundles nsis --target x86_64-pc-windows-gnu",
    "pack:mac": "tauri build --bundles dmg"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "monaco-editor": "^0.53.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "vite": "^6.2.4"
  }
}
